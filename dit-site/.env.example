# Hosted Sites runtime: optional dedicated mainnet RPC (server secret)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Registered launches only; no secret material. Each record must match finalized chain data.
AGENT_LAUNCH_REGISTRY=[]
# Example record shape: {"agent":"GHOST_001","wallet":"PUBLIC_KEY","mint":"MINT_ADDRESS","signature":"CREATION_TRANSACTION_SIGNATURE","narrative":"Actual generated narrative"}

# Separate trusted backend process only — NEVER use these in browser code or the hosting manifest.
DIT_AGENT_ID=GHOST_001
# JSON array of 64 secret-key bytes from a funded dedicated Solana keypair, supplied via secret manager.
DIT_AGENT_SECRET_KEY_JSON=
# Approved token metadata JSON must be uploaded to an immutable IPFS/Arweave URI first.
DIT_TOKEN_NAME=
DIT_TOKEN_SYMBOL=
DIT_METADATA_URI=
DIT_NARRATIVE=
# Absolute spending limit: network fee plus calculated new-account rent, in lamports.
DIT_MAX_LAUNCH_LAMPORTS=20000000
# Intent ID prevents accidental reruns. Keep launch-records/ persistent and access-controlled.
DIT_LAUNCH_ID=
# Optional dedicated audit output directory, persistent and writable only by the launch service.
DIT_RECORDS_DIR=./launch-records


# DIT BACKEND & RESEARCH (use env vars; do not commit credentials)
# Production backend - Postgres Supabase project URL, service key ONLY on trusted server
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local file-backed demo: npm run dev (no Supabase needed). In local mode, identity is INSECURE TEST-ONLY.
DIT_DEV_AUTH=1
DIT_STORE_FILE=.data/dit-store.json
DIT_START_SCHEDULER=1
PORT=4173
DIT_TICK_SECONDS=60
DIT_CYCLE_INTERVAL_MINUTES=60
DIT_AGENT_STAGGER_MINUTES=7
DIT_MAX_CYCLES_PER_AGENT_DAY=24
DIT_MAX_LLM_TOKENS_PER_AGENT_DAY=60000
DIT_JOB_TIMEOUT_SECONDS=180
DIT_WORKER_CONCURRENCY=2
# DIT discovers the same installed Ollama models JARVIS uses. The default is LOCAL ONLY.
# Explicitly enable remote endpoints only when you own the gateway.
DIT_LLM_PROVIDER=auto
# Operator UI saves model choices to ignored .data/operator-settings.json.
# Start the local companion and visit http://127.0.0.1:4173/operator.
# Providers: ollama, openai-local (OpenAI-compatible localhost), or jarvis research bridge.
# JARVIS manager is addressed over loopback only; it never authorizes token launches.
OLLAMA_URL=http://127.0.0.1:11434
DIT_MODEL_DEFAULT=
DIT_MODEL_GHOST=
DIT_MODEL_NULL=
DIT_MODEL_ECHO=
DIT_ALLOW_REMOTE_LLM=0
# Optional Anthropic fallback for auto mode; never expose credentials to browser.
# If no provider is reachable, research continues without invented concepts.
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_PRICE_IN_USD_PER_MTOK=
LLM_PRICE_OUT_USD_PER_MTOK=
# Optional feed access
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DIT_USER_AGENT=DeadInternetTheoryResearch/1.0 (contact: configure)
# Circuit schema is a DIT adapter contract; verify real provider signature before production use.
CIRCUIT_WEBHOOK_SECRET=
CIRCUIT_REQUIRE_TIMESTAMP=1
# Fee targets record calculations, not actual transfers.
TREASURY_BPS=2500
TREASURY_TRANSFER_MECHANISM=none
TREASURY_WALLET=
REMAINDER_WALLET=
