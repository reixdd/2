# ── COLOSSEUM environment ────────────────────────────────────────────
# Copy to .env. Credentials live ONLY on the server; the browser never sees them.

PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# OpenRouter (https://openrouter.ai/keys). Leave empty to keep OpenRouter contenders non-operational.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Ollama (OpenAI-compatible endpoint). Contenders become operational only if the model is pulled.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Any other OpenAI-compatible server (vLLM, LM Studio, llama.cpp server, ...). Optional.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Battle engine
DEFAULT_TEMPERATURE=0
DEFAULT_MAX_TOKENS=4096
ENTRY_TIMEOUT_MS=180000
MAX_CONCURRENT_BATTLES=3
MAX_ENTRANTS=6

# Free CPU inference: npm run setup:local downloads two official small Qwen models once.
# Inference then works offline. No provider account or API credits required.
LOCAL_MODEL_DIR=./.models
LOCAL_THREADS=4

# Where battle JSON is saved
DATA_DIR=./data
